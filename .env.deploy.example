# Copier ce fichier : cp .env.deploy.example .env.deploy
# Ne jamais committer .env.deploy (déjà dans .gitignore).

# Tag Git / image GHCR à mettre en service (doit exister sur ghcr.io)
IMAGE_TAG=v1.2.0

# Secret JWT de l'environnement de test (remplacer par une valeur longue)
JWT_SECRET=remplacez-moi-par-une-chaine-longue-et-aleatoire

# Variables optionnelles (valeurs par défaut dans compose.staging.yaml)
# JWT_EXPIRES_IN=1d
# STOCK_ALERT_THRESHOLD=8
# CRON_SCHEDULE=0 16 * * *
# ADMIN_EMAIL=admin@smartstore.tn
