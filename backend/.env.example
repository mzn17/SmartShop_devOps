# ── Serveur ───────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────────
# Base créée manuellement dans MongoDB Compass.
# Exemple local : mongodb://127.0.0.1:27017/smartstore
MONGODB_URI=mongodb://127.0.0.1:27017/smartstore

# ── Authentification JWT ──────────────────────────────────────────────
JWT_SECRET=remplacez-moi-par-une-chaine-longue-et-aleatoire
JWT_EXPIRES_IN=1d

# ── Stock ─────────────────────────────────────────────────────────────
STOCK_ALERT_THRESHOLD=8
CRON_SCHEDULE=0 16 * * *

# ── E-mail (optionnel) ────────────────────────────────────────────────
ADMIN_EMAIL=admin@smartstore.tn
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SmartStore <no-reply@smartstore.tn>
